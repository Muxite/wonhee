+        cfg.palette.hi = parse_color(pal["hi"], cfg.palette.hi);
+    }
+
+    if (root.has("sources")) {
+        for (const json::Value& s : root["sources"].as_array()) {
+            SourceConfig sc;
+            sc.type = s["type"].as_string();
+            sc.x = static_cast<int>(s["x"].as_number());
+            sc.y = static_cast<int>(s["y"].as_number());
+            sc.amplitude = static_cast<float>(s["amplitude"].as_number());
+            sc.frequency = static_cast<float>(s["frequency"].as_number());
+            sc.offset = static_cast<float>(s["offset"].as_number());
+            sc.start = static_cast<unsigned int>(s["start"].as_number());
+            sc.end = static_cast<unsigned int>(s["end"].as_number());
+            cfg.sources.push_back(sc);
+        }
+    }
+    return cfg;
+}
+
+static void add_source(world& w, const SourceConfig& sc) {
+    if (sc.type == "sine")
