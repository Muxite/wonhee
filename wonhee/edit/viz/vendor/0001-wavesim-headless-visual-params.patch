index 0000000..a0b30f2
--- /dev/null
+++ b/src/wave/json_lite.h
@@ -0,0 +1,166 @@
+// Minimal, header-only JSON reader for wavegen's params.json. Not general-purpose (no
+// comments, no trailing commas) — it only needs to parse whatever vizkit's Python side
+// writes via json.dumps(). Added as new driver code alongside the visual-params patch;
+// never touched by or touching the wave-equation physics in world.*/calculate_wave_cuda.*.
+#pragma once
+#include <cctype>
+#include <map>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace json {
+
+class Value {
+public:
+    enum class Type { Null, Bool, Number, String, Array, Object };
+
+    Value() : type_(Type::Null) {}
+    static Value make_object() { Value v; v.type_ = Type::Object; return v; }
+    static Value make_array() { Value v; v.type_ = Type::Array; return v; }
+
+    Type type() const { return type_; }
+    bool has(const std::string& key) const { return type_ == Type::Object && object_.count(key) > 0; }
+
+    const Value& operator[](const std::string& key) const {
+        static Value null_value;
+        auto it = object_.find(key);
+        return it == object_.end() ? null_value : it->second;
+    }
+
+    double as_number() const { return number_; }
+    const std::string& as_string() const { return string_; }
+    bool as_bool() const { return bool_; }
+    const std::vector<Value>& as_array() const { return array_; }
+
+    Type type_ = Type::Null;
+    double number_ = 0.0;
+    std::string string_;
+    bool bool_ = false;
+    std::vector<Value> array_;
+    std::map<std::string, Value> object_;
+};
+
+class Parser {
+public:
+    explicit Parser(const std::string& text) : text_(text), pos_(0) {}
+
+    Value parse() {
+        skip_ws();
+        Value v = parse_value();
+        return v;
+    }
+
+private:
+    const std::string& text_;
+    size_t pos_;
+
+    char peek() { return pos_ < text_.size() ? text_[pos_] : '\0'; }
+    char next() { return pos_ < text_.size() ? text_[pos_++] : '\0'; }
+    void skip_ws() { while (pos_ < text_.size() && std::isspace((unsigned char)text_[pos_])) pos_++; }
+
+    void expect(char c) {
+        if (next() != c) throw std::runtime_error("json_lite: expected '" + std::string(1, c) + "'");
+    }
+
+    Value parse_value() {
+        skip_ws();
+        char c = peek();
+        if (c == '{') return parse_object();
+        if (c == '[') return parse_array();
+        if (c == '"') return parse_string_value();
+        if (c == 't' || c == 'f') return parse_bool();
+        if (c == 'n') { pos_ += 4; return Value(); }
+        return parse_number();
+    }
+
+    Value parse_object() {
+        Value v = Value::make_object();
+        expect('{');
+        skip_ws();
+        if (peek() == '}') { pos_++; return v; }
+        while (true) {
+            skip_ws();
+            Value key = parse_string_value();
+            skip_ws();
+            expect(':');
+            Value val = parse_value();
+            v.object_[key.as_string()] = val;
+            skip_ws();
+            char c = next();
+            if (c == '}') break;
+            if (c != ',') throw std::runtime_error("json_lite: expected ',' or '}' in object");
+        }
+        return v;
+    }
+
+    Value parse_array() {
+        Value v = Value::make_array();
+        expect('[');
+        skip_ws();
+        if (peek() == ']') { pos_++; return v; }
+        while (true) {
+            Value val = parse_value();
+            v.array_.push_back(val);
+            skip_ws();
+            char c = next();
+            if (c == ']') break;
+            if (c != ',') throw std::runtime_error("json_lite: expected ',' or ']' in array");
+        }
+        return v;
+    }
+
+    Value parse_string_value() {
+        Value v;
+        v.type_ = Value::Type::String;
+        expect('"');
+        std::string out;
+        while (true) {
+            char c = next();
+            if (c == '"' || c == '\0') break;
+            if (c == '\\') {
+                char esc = next();
+                switch (esc) {
+                    case 'n': out += '\n'; break;
+                    case 't': out += '\t'; break;
+                    case '"': out += '"'; break;
+                    case '\\': out += '\\'; break;
+                    case '/': out += '/'; break;
+                    default: out += esc; break;
+                }
+            } else {
+                out += c;
+            }
+        }
+        v.string_ = out;
+        return v;
+    }
+
+    Value parse_bool() {
+        Value v;
+        v.type_ = Value::Type::Bool;
+        if (peek() == 't') { pos_ += 4; v.bool_ = true; } else { pos_ += 5; v.bool_ = false; }
+        return v;
+    }
+
+    Value parse_number() {
+        Value v;
+        v.type_ = Value::Type::Number;
+        size_t start = pos_;
+        if (peek() == '-') pos_++;
+        while (pos_ < text_.size() && (std::isdigit((unsigned char)peek()) || peek() == '.' ||
+                                        peek() == 'e' || peek() == 'E' || peek() == '+' || peek() == '-')) {
+            pos_++;
+        }
+        v.number_ = std::stod(text_.substr(start, pos_ - start));
+        return v;
+    }
+};
+
+inline Value parse(const std::string& text) {
+    Parser p(text);
+    return p.parse();
+}
+
+}  // namespace json
